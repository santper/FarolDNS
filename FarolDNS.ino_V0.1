#include <WiFi.h>
#include <DNSServer.h>

// --- CONFIGURAÇÕES ---
// Coloque aqui o nome e a senha da sua rede Wi-Fi
const char* ssid = "santper";
const char* password = "aptodenill2";

// Porta padrão para o serviço DNS
const byte DNS_PORT = 53;

// IP que será respondido para QUALQUER consulta DNS
const IPAddress responseIP(192, 168, 1, 100); 
// --- FIM DAS CONFIGURAÇÕES ---

DNSServer dnsServer;

void setup() {
  Serial.begin(115200);
  Serial.println("\nIniciando...");

  // Conecta ao Wi-Fi
  WiFi.begin(ssid, password);
  Serial.print("Conectando ao Wi-Fi ");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  
  Serial.println("\nConectado!");
  Serial.print("Endereço IP do ESP32: ");
  Serial.println(WiFi.localIP());

  // Inicia o servidor DNS
  // O "*" significa que vamos responder a qualquer domínio solicitado.
  dnsServer.start(DNS_PORT, "*", responseIP);
  Serial.println("Servidor DNS iniciado.");
  Serial.print("Respondendo a todas as consultas com o IP: ");
  Serial.println(responseIP);
}

void loop() {
  // Processa as requisições DNS que chegarem.
  // É crucial chamar esta função repetidamente no loop.
  dnsServer.processNextRequest();
}